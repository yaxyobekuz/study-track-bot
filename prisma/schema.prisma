// Study-Track BOT — PostgreSQL (Prisma) schema (subset).
//
// DIQQAT: Bot server bilan BIR XIL PostgreSQL bazani ishlatadi. Bu schema faqat
// bot ishlatadigan modellarni o'z ichiga oladi (User, TgUser, Grade, Subject,
// Class, Holiday, Schedule + kerakli junction/child). Jadvallar server schema'si
// tomonidan yaratiladi/migratsiya qilinadi — bot HECH QANDAY migratsiya
// yugurtmaydi (faqat `prisma generate`). Server schema o'zgarsa, bu faylni ham
// mos ravishda yangilash kerak (server/prisma/schema.prisma bilan sinxron).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
}

enum ScheduleDay {
  dushanba
  seshanba
  chorshanba
  payshanba
  juma
  shanba
}

enum HolidayType {
  single
  range
  recurring
}

// Ish vaqti QAYERDAN olinadi (server: `WorkTimeSource`).
//   manual   — `workStartTime`/`workEndTime` yoki rol standarti
//   schedule — dars jadvalidan hisoblanadi (bot bu holatda vaqtni
//              KO'RSATMAYDI: hisob serverdagi `summarizeWeek` da va uni
//              botda takrorlash ikkinchi haqiqat manbasini yaratardi)
enum WorkTimeSource {
  manual
  schedule
}

// ── XODIM TEZKOR MA'LUMOTI UCHUN ─────────────────────────────
// Quyidagi uchta enum ham server schema'sidan AYNAN ko'chirilgan.

enum AttendanceStatus {
  present
  late
  absent
  excused
}

enum TaskStatus {
  pending
  extended
  pending_rejected
  stopped
  completed
  pending_review
}

enum PayrollStatus {
  unpaid
  partial
  paid
  cancelled
}

enum SalaryType {
  fixed
  kpi
  mixed
}

model User {
  id               String    @id @db.Char(24)
  username         String    @unique
  password         String
  plainPassword    String?   @map("plain_password")
  firstName        String    @map("first_name")
  lastName         String?   @map("last_name")
  telegramIds      String[]  @map("telegram_ids")
  role             String
  // QO'SHIMCHA ROLLAR — bir odam o'qituvchi HAM ma'muriyat bo'lishi mumkin
  // (server: `utils/permissions.js#hasRole`). Bot uni faqat O'QIYDI:
  // "bu xodimda dars bormi" degan savol shu massivni ham hisobga olishi
  // kerak, aks holda asosiy roli `reception` bo'lgan o'qituvchi botda
  // darslarini ko'rmay qolardi.
  extraRoles       String[]  @default([]) @map("extra_roles")
  isActive         Boolean   @default(true) @map("is_active")
  gender           Gender?
  coinBalance      Int       @default(0) @map("coin_balance")
  penaltyPoints    Int       @default(0) @map("penalty_points")
  isArchived       Boolean   @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  archiveSnapshot  Json?     @map("archive_snapshot")
  workTimeSource   WorkTimeSource @default(manual) @map("work_time_source")
  workStartTime    String?   @map("work_start_time")
  workEndTime      String?   @map("work_end_time")
  workDays         Int[]     @map("work_days")
  weeklySchedule   Json      @default("{}") @map("weekly_schedule")
  premiumIsActive  Boolean   @default(false) @map("premium_is_active")
  premiumExpiresAt DateTime? @map("premium_expires_at")
  profilePicture   String?   @map("profile_picture") @db.Char(24)
  emojiBadgeId     String?   @map("emoji_badge_id")
  displayName      String?   @map("display_name")
  nameColor        String?   @map("name_color")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  classes UserClass[]

  @@index([role, isActive])
  @@map("users")
}

model UserClass {
  userId  String @map("user_id") @db.Char(24)
  classId String @map("class_id") @db.Char(24)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
  @@index([classId])
  @@map("user_classes")
}

model Class {
  id        String   @id @db.Char(24)
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String   @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserClass[]

  @@map("classes")
}

model Subject {
  id          String   @id @db.Char(24)
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Char(24)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("subjects")
}

model Grade {
  id          String   @id @db.Char(24)
  studentId   String   @map("student_id") @db.Char(24)
  subjectId   String   @map("subject_id") @db.Char(24)
  classId     String   @map("class_id") @db.Char(24)
  teacherId   String   @map("teacher_id") @db.Char(24)
  grade       Int
  comment     String?
  date        DateTime
  lessonOrder Int      @default(1) @map("lesson_order")
  isEdited    Boolean  @default(false) @map("is_edited")
  editHistory Json     @default("[]") @map("edit_history")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([studentId, subjectId, date, lessonOrder])
  @@index([classId, date])
  @@index([teacherId, date])
  @@map("grades")
}

model Schedule {
  id        String      @id @db.Char(24)
  classId   String      @map("class_id") @db.Char(24)
  day       ScheduleDay
  createdBy String      @map("created_by") @db.Char(24)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  lessons ScheduleLesson[]

  @@unique([classId, day])
  @@map("schedules")
}

model ScheduleLesson {
  id         String  @id @db.Char(24)
  scheduleId String  @map("schedule_id") @db.Char(24)
  subjectId  String  @map("subject_id") @db.Char(24)
  teacherId  String  @map("teacher_id") @db.Char(24)
  order      Int
  startTime  String? @map("start_time")
  endTime    String? @map("end_time")
  position   Int

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([teacherId])
  @@map("schedule_lessons")
}

// TELEGRAM BOG'LANISHI — o'quvchi (ota-ona) YOKI xodim.
//
//   userId    — bog'langan ODAM, roli qanday bo'lishidan qat'i nazar
//   linkKind  — "student" | "staff" (TUR, rol EMAS: rol `User.role` dan
//               jonli o'qiladi, muhrlanmaydi — odamning roli o'zgarsa
//               botda noto'g'ri menyu chiqmasligi uchun)
//   student   — faqat linkKind='student' da to'ladi, xodimda NULL
//
// To'liq izoh: server/prisma/schema.prisma dagi ayni model.
model TgUser {
  id                   String   @id @db.Char(24)
  telegramId           String   @unique @map("telegram_id")
  chatId               String   @map("chat_id")
  userId               String   @map("user_id") @db.Char(24)
  linkKind             String   @default("student") @map("link_kind")
  student              String?  @db.Char(24)
  firstName            String?  @map("first_name")
  lastName             String?  @map("last_name")
  username             String?
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  lastActivity         DateTime @default(now()) @map("last_activity")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([student])
  @@index([userId])
  @@index([linkKind, isActive])
  @@index([notificationsEnabled, isActive])
  @@map("tg_users")
}

model Holiday {
  id                 String      @id @db.Char(24)
  name               String
  description        String?
  type               HolidayType
  date               DateTime?
  startDate          DateTime?   @map("start_date")
  endDate            DateTime?   @map("end_date")
  recurringDate      Json?       @map("recurring_date")
  recurringStartDate Json?       @map("recurring_start_date")
  recurringEndDate   Json?       @map("recurring_end_date")
  isActive           Boolean     @default(true) @map("is_active")
  createdBy          String?     @map("created_by") @db.Char(24)
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("holidays")
}

// ─────────────────────────────────────────────
// XODIM TEZKOR MA'LUMOTI (faqat O'QISH)
// ─────────────────────────────────────────────
//
// ⚠️ UCHALASI HAM SERVER SCHEMA'SINING QISMAN NUSXASI. Bot bu
// jadvallarga HECH QACHON YOZMAYDI — davomat belgilash, topshiriq
// yakunlash va oylik hisoblash qoidalari serverda (`attendance.service`,
// `task.service`, `payroll` dvigateli) va ularni botdan takrorlash
// ikkita haqiqat manbasini yaratardi. Shu sababli bu modellar
// `AUTO_ID_MODELS` ga ham KIRMAYDI (`src/config/branch.js`).
//
// ⚠️ USTUNLAR TO'LIQ EMAS — faqat botda ko'rsatiladigan maydonlar.
// Yo'q ustun Prisma so'rovlariga xalaqit bermaydi, LEKIN nullability
// server bilan BIR XIL bo'lishi shart: bu yerda NOT NULL deb yozilgan
// ustun bazada NULL chiqsa, o'qish paytida jimgina yiqiladi.

model Attendance {
  id              String           @id @db.Char(24)
  userId          String           @map("user_id") @db.Char(24)
  date            DateTime
  checkIn         DateTime?        @map("check_in")
  checkOut        DateTime?        @map("check_out")
  status          AttendanceStatus @default(present)
  isLate          Boolean          @default(false) @map("is_late")
  lateMinutes     Int              @default(0) @map("late_minutes")
  isEarlyOut      Boolean          @default(false) @map("is_early_out")
  earlyOutMinutes Int              @default(0) @map("early_out_minutes")
  excuseReason    String?          @map("excuse_reason")
  absenceReason   String?          @map("absence_reason") @db.Char(24)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([userId, date])
  @@index([userId, createdAt(sort: Desc)])
  @@map("attendances")
}

model Task {
  id            String     @id @db.Char(24)
  title         String
  description   String
  assignee      String     @db.Char(24)
  createdBy     String     @map("created_by") @db.Char(24)
  status        TaskStatus @default(pending)
  dueDate       DateTime   @map("due_date")
  penaltyPoints Int        @default(1) @map("penalty_points")
  createdAt     DateTime   @default(now()) @map("created_at")

  @@index([assignee, status])
  @@map("tasks")
}

model PayrollEntry {
  id      String @id @db.Char(24)
  staffId String @map("staff_id") @db.Char(24)
  month   Int // YYYYMM

  amount     Decimal @db.Decimal(14, 2)
  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(14, 2)

  status     PayrollStatus @default(unpaid)
  salaryType SalaryType    @default(fixed) @map("salary_type")

  fixedAmount     Decimal @default(0) @map("fixed_amount") @db.Decimal(14, 2)
  allowanceAmount Decimal @default(0) @map("allowance_amount") @db.Decimal(14, 2)
  kpiAmount       Decimal @default(0) @map("kpi_amount") @db.Decimal(14, 2)
  lessonHours     Decimal @default(0) @map("lesson_hours") @db.Decimal(10, 2)
  deductionAmount Decimal @default(0) @map("deduction_amount") @db.Decimal(14, 2)
  suspendedAmount Decimal @default(0) @map("suspended_amount") @db.Decimal(14, 2)
  absenceAmount   Decimal @default(0) @map("absence_amount") @db.Decimal(14, 2)

  categoryName String @default("") @map("category_name")
  positionName String @default("") @map("position_name")

  cancelledAt DateTime? @map("cancelled_at")
  paidAt      DateTime? @map("paid_at")

  @@unique([staffId, month])
  @@index([staffId, month(sort: Desc)])
  @@map("payroll_entries")
}

// ─────────────────────────────────────────────
// FAOLLIK
// ─────────────────────────────────────────────
//
// ⚠️ SERVER SCHEMA'SINING NUSXASI (`server/prisma/schema.prisma` dagi
// `ActivityEvent`). Bot migratsiya yugurtmaydi — jadvalni server
// yaratadi (`20260906180000_activity_and_multirole`), bu yerda faqat
// YOZISH uchun tavsif turadi.
//
// ⚠️ NIMA UCHUN BOT YOZADI. "Bu sinfning 25 ta ota-onasidan 20 tasi
// bugun botdan foydalandi" degan savolga faqat BOT javob bera oladi:
// server ota-onaning tugma bosganini ko'rmaydi. Ilgari `lastActivity`
// faqat hisob bog'langan lahzada bir marta yozilar edi, ya'ni u amalda
// "qachon bog'landi" degani bo'lib qolgan edi.
//
// ⚠️ `ActivityEvent` ni `AUTO_ID_MODELS` ga QO'SHISH SHART
// (`src/config/branch.js`) — aks holda `id` bo'sh ketadi va INSERT
// yiqiladi.

enum ActivityChannel {
  bot
  admin
  teacher
  student
  reception
  worker
}

model ActivityEvent {
  id String @id @db.Char(24)

  channel ActivityChannel
  action  String          @db.VarChar(48)

  // "user:<id>" yoki "tg:<telegramId>" — COUNT(DISTINCT) uchun yagona kalit
  actorKey String @map("actor_key") @db.VarChar(40)

  userId     String? @map("user_id") @db.Char(24)
  telegramId String? @map("telegram_id")
  studentId  String? @map("student_id") @db.Char(24)

  occurredAt DateTime @default(now()) @map("occurred_at")
  // Kun koordinatasi — Toshkent kuni, UTC yarim tunida
  day        DateTime @map("day") @db.Date

  meta Json?

  @@index([day, channel])
  @@index([channel, occurredAt(sort: Desc)])
  @@index([userId, day])
  @@index([telegramId, day])
  @@index([studentId, day])
  @@index([actorKey, day])
  @@map("activity_events")
}

// ─────────────────────────────────────────────
// MUAMMOLAR (bot → ma'muriyat)
// ─────────────────────────────────────────────
//
// ⚠️ BU YERDA BOT YOZADI — `staff.service.js` dagi "faqat o'qish"
// qoidasidan ATAYLAB istisno, lekin u qoidaga qarshi emas. Qoida
// SERVERDAGI BIZNES QOIDASINI botda takrorlamaslik haqida (davomat
// belgilash, topshiriq yakunlash, oylik hisoblash — ularning hammasida
// serverda qoida bor va bot nusxa qilsa ikkita haqiqat manbasi
// paydo bo'lardi). Muammo yaratishda esa serverda hech qanday qoida YO'Q:
// server muammo YARATMAYDI, faqat ko'rib chiqadi (`status`, `reply`).
// Ya'ni ikki tomon bir ustunga yozmaydi va nusxalanadigan mantiq yo'q.
//
// ⚠️ `Issue` — `AUTO_ID_MODELS` DA (`src/config/branch.js`). Bo'lmasa
// `id` bo'sh ketadi va INSERT yiqiladi: jadvalda `@default` yo'q, ID
// 24-hex ObjectId bo'lishi shart.
//
// To'liq izoh: server/prisma/schema.prisma dagi ayni modellar.

/** Ko'rib chiqish holati — faqat PANEL o'zgartiradi, bot o'qimaydi ham. */
enum IssueStatus {
  new
  in_review
  resolved
  rejected
}

/**
 * MUAMMO KATEGORIYASI — botdagi klaviatura shundan chiziladi.
 *
 * ⚠️ BOT FAQAT O'QIYDI va faqat `isActive = true` ni ko'rsatadi:
 * kategoriyalar admin panelda sozlanadi, botda yaratilmaydi.
 *
 * ⚠️ USTUNLAR TO'LIQ — jadvalda nomi va holatidan boshqa hech narsa yo'q.
 */
model IssueCategory {
  id        String   @id @db.Char(24)
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issues Issue[]

  @@index([isActive, name])
  @@map("issue_categories")
}

/**
 * BOTDAN YUBORILGAN MUAMMO.
 *
 * `authorKind` — bog'lanish TURI (`TgUser.linkKind` bilan ayni ma'noda),
 * ROL EMAS. `chatId` muhrlanadi: javob o'sha chatga qaytadi.
 *
 * ⚠️ `status`/`reply`/`reviewed*`/`replied*` ustunlariga BOT TEGMAYDI —
 * ular panelning maydoni. Bot `INSERT` da ularni berib yubormasligi kerak,
 * aks holda ma'muriyatning javobi ustiga yozilardi.
 */
model Issue {
  id         String      @id @db.Char(24)
  categoryId String      @map("category_id") @db.Char(24)
  userId     String      @map("user_id") @db.Char(24)
  authorKind String      @map("author_kind")
  body       String
  status     IssueStatus @default(new)

  telegramId String? @map("telegram_id")
  chatId     String? @map("chat_id")

  reply      String?
  reviewedBy String?   @map("reviewed_by") @db.Char(24)
  reviewedAt DateTime? @map("reviewed_at")
  repliedAt  DateTime? @map("replied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category IssueCategory @relation(fields: [categoryId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([userId])
  @@map("issues")
}
