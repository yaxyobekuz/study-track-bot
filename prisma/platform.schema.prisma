// Study-Track BOT — PLATFORMA schema'si (subset).
//
// Bot ham server kabi FILIALLASHTIRILGAN: har filial o'z PostgreSQL
// schema'sida yashaydi va bot qaysi schema'ga borishni platformadagi
// yo'naltirgichlardan biladi:
//
//   UserDirectory     — username → qaysi filial (login uchun)
//   TelegramDirectory — telegramId → qaysi filial (har xabar uchun)
//
// Ikkinchisi bo'lmasa bot har kelgan xabarda BARCHA filial schema'larini
// skanerlashiga to'g'ri kelardi.
//
// DIQQAT: jadvallar SERVER tomonidan yaratiladi/migratsiya qilinadi
// (server/prisma/platform/schema.prisma). Bot hech qanday migratsiya
// yugurtmaydi — faqat `prisma generate`. Server schema o'zgarsa, bu faylni
// ham mos ravishda yangilash kerak.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/platform"
}

datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_DATABASE_URL")
}

enum BranchStatus {
  provisioning
  ready
  failed
}

model Branch {
  id String @id @db.Char(24)

  code       String @unique
  name       String
  schemaName String @unique @map("schema_name")

  shortName String @default("") @map("short_name")
  address   String @default("")
  phone     String @default("")

  status         BranchStatus @default(provisioning)
  provisionError String?      @map("provision_error")

  isDefault  Boolean   @default(false) @map("is_default")
  isActive   Boolean   @default(true) @map("is_active")
  isArchived Boolean   @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")
  sortOrder  Int       @default(0) @map("sort_order")

  createdBy String?  @map("created_by") @db.Char(24)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         UserDirectory[]
  telegramLinks TelegramDirectory[]

  @@index([isArchived, isActive, sortOrder])
  @@map("branches")
}

model UserDirectory {
  id       String @id @db.Char(24)
  username String @unique

  branchId String @map("branch_id") @db.Char(24)

  role      String
  firstName String @default("") @map("first_name")
  lastName  String @default("") @map("last_name")

  isActive   Boolean @default(true) @map("is_active")
  isArchived Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, role])
  @@index([branchId, isArchived])
  @@map("user_directory")
}

// ROLLAR — barcha filiallarga UMUMIY (server: platform/schema.prisma).
//
// ⚠️ Bot faqat STANDART ISH VAQTI uchun o'qiydi. Xodimning o'zida
// `workStartTime`/`workEndTime` qo'yilmagan bo'lsa (ko'pincha shunday),
// amaldagi vaqt rol standartidan keladi — serverdagi
// `user.service.js#effectiveSchedule` bilan AYNI qoida. Bu ustunlarsiz
// botdagi davomat bo'limi "09:00 dan" degan satrni ko'rsata olmasdi.
//
// ⚠️ Ruxsatlar (`permissions`) ATAYLAB OLINMAGAN: bot hech qanday
// ruxsatga qarab shoxlanmaydi — xodimga faqat O'ZINING ma'lumoti
// ko'rsatiladi va u har doim o'ziga ruxsat etilgan.
model Role {
  id    String @id @db.Char(24)
  name  String @unique
  value String @unique

  workStartTime String?  @map("work_start_time")
  workEndTime   String?  @map("work_end_time")
  workDays      Int[]    @default([1, 2, 3, 4, 5]) @map("work_days")

  @@map("roles")
}

// telegramId → qaysi filial. Har kelgan xabarda shu yerga qaraladi.
//
//   userId    — bog'langan ODAM (o'quvchi yoki xodim)
//   linkKind  — "student" | "staff"
//   studentId — faqat linkKind='student' da to'ladi, xodimda NULL
model TelegramDirectory {
  telegramId String @id @map("telegram_id")

  branchId String @map("branch_id") @db.Char(24)

  userId    String  @map("user_id") @db.Char(24)
  linkKind  String  @default("student") @map("link_kind")
  studentId String? @map("student_id") @db.Char(24)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([userId])
  @@map("telegram_directory")
}

/**
 * BOT KO'RGAN GURUH/KANAL — admin paneldagi "Bot sozlamalari" tabi
 * aynan shu jadvalni ko'rsatadi.
 *
 * ⚠️ BOT BU YERGA YOZADI (`TelegramDirectory` dan keyin ikkinchisi).
 * Telegram Bot API "qaysi guruhlarda adminman" degan savolga javob
 * bermaydi, shuning uchun ro'yxat `my_chat_member` hodisasidan
 * to'planadi — serverdagi izohga qara
 * (`server/prisma/platform/schema.prisma#TelegramGroup`).
 *
 * ⚠️ `chatId` — PK va TABIIY kalit, ya'ni `id` generatsiya kerak emas:
 * shu sababli bu model `AUTO_ID_MODELS` ro'yxatida YO'Q.
 *
 * ⚠️ `isOfficial` ni BOT HECH QACHON o'zgartirmaydi — u admin panelda
 * qo'yiladigan belgi. Bot `upsert` qilganda `update` bloki faqat
 * Telegram'dan kelgan maydonlarga tegadi.
 */
model TelegramGroup {
  chatId String @id @map("chat_id")

  type     String  @default("group")
  title    String
  username String?

  status String @default("member")

  canPostMessages Boolean @default(false) @map("can_post_messages")
  canInviteUsers  Boolean @default(false) @map("can_invite_users")

  isOfficial     Boolean   @default(false) @map("is_official")
  officialBy     String?   @map("official_by") @db.Char(24)
  officialAt     DateTime? @map("official_at")
  officialBranch String?   @map("official_branch") @db.Char(24)

  addedByTgId String? @map("added_by_tg_id")

  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([isOfficial])
  @@map("telegram_groups")
}

/**
 * RASMIY GURUHDAN KELGAN XABAR — AI tahlili uchun XOMASHYO.
 *
 * Bot rasmiy guruhlarda KUZATUVCHI: hech narsa yozmaydi, javob bermaydi,
 * faqat o'qib shu jadvalga qo'yadi. Tahlilni SERVER qiladi (har 30
 * daqiqada, `server/src/jobs/groupSignal.job.js`) — botda OpenAI yo'q va
 * bo'lishi ham shart emas.
 *
 * ⚠️ FAQAT `isOfficial` GURUHDAN yoziladi (`group.service.js#captureMessage`).
 * Rasmiy belgisi — ma'muriyatning kuzatuvga ochiq roziligi.
 *
 * ⚠️ BU NAVBAT, ARXIV EMAS: server tahlildan keyin o'chiradi. Shuning
 * uchun bu yerda indeks va maydonlar minimal — uzoq saqlanadigan narsa
 * emas.
 *
 * ⚠️ SERVERDAGI NUSXASI BILAN BIR XIL BO'LISHI SHART:
 * `server/prisma/platform/schema.prisma`. Migratsiya o'sha yerda.
 */
model GroupMessage {
  id String @id @db.Char(24)

  chatId    String @map("chat_id")
  messageId String @map("message_id")

  senderTgId String? @map("sender_tg_id")
  senderName String? @map("sender_name")

  text String

  replyToText String? @map("reply_to_text")

  sentAt DateTime @map("sent_at")

  analyzedAt DateTime? @map("analyzed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([chatId, messageId])
  @@index([analyzedAt, sentAt])
  @@map("group_messages")
}
